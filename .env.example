POSTGRES_DB=baking_and_crafts_kjg
POSTGRES_USER=baking_and_crafts_kjg
POSTGRES_PASSWORD=baking_and_crafts_kjg_local_password

APP_DATASOURCE_URL=jdbc:postgresql://localhost:5432/baking_and_crafts_kjg
APP_DATASOURCE_USERNAME=baking_and_crafts_kjg
APP_DATASOURCE_PASSWORD=baking_and_crafts_kjg_local_password

APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-local-characters
